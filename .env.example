# FreeSolo / Flash: managed train + student adapter deploy
FREESOLO_API_KEY=
# OpenRouter: reward MCQ judge in model/grpo/judge.py (small LM, not FreeSolo)
OPENROUTER_API_KEY=
# WANDB_API_KEY=...   # picked up automatically by `flash train` when [wandb] is set
# Optional judge overrides
# TECHTO_JUDGE_BASE_URL=https://openrouter.ai/api/v1
# TECHTO_JUDGE_MODEL=qwen/qwen-2.5-7b-instruct

# Backboard (https://backboard.io) is the only AI infrastructure provider
# used by TechTO's virtual planning department. Server-only: never exposed
# to the browser. Live API required (no mock adapter).
BACKBOARD_API_KEY=replace_with_your_backboard_api_key
BACKBOARD_API_BASE_URL=https://app.backboard.io/api

# Citizen-reaction population simulator: "real-opinion" (default; calls the
# trained persona-opinion model, sampling real resident_personas) or
# "freesolo" (legacy: asks a generic chat model to return a whole batch as
# JSON -- kept only as a rollback path).
TECHTO_CITIZEN_REACTION_PROVIDER=real-opinion

# FreeSolo (server-only). Required for both citizen-reaction provider modes.
FREESOLO_BASE_URL=
FREESOLO_REACTION_MODEL_ALIAS=techto-citizen-reaction
FREESOLO_TIMEOUT_SECONDS=45

# Real opinion model (model/sft, model/grpo), used when
# TECHTO_CITIZEN_REACTION_PROVIDER=real-opinion. Served via the same
# FreeSolo/Modal deployment as FREESOLO_BASE_URL/FREESOLO_API_KEY above.
TECHTO_OPINION_MODEL_ALIAS=flash-1784401342-0d51be72
# Real personas Monte-Carlo-sampled per demographic archetype per policy
# (not per-cohort, not all 13k+ residents -- see persona-sampler.ts).
TECHTO_OPINION_SAMPLE_SIZE=3
# Adaptive ceiling: more samples are drawn (up to this many) only for an
# archetype whose initial opinions disagree a lot.
TECHTO_OPINION_MAX_SAMPLE_SIZE=6
# Max concurrent live calls to the opinion model.
TECHTO_OPINION_CONCURRENCY=128
# Citywide acceptance readout for score_population / run_twin_analysis
# (src/lib/citizen-reaction/policy-acceptance.ts): real residents are drawn
# in batches until the confidence interval half-width reaches the target or
# the max sample size is hit.
TECHTO_POLICY_BATCH_SIZE=24
TECHTO_POLICY_MIN_SAMPLE_SIZE=24
TECHTO_POLICY_MAX_SAMPLE_SIZE=100
TECHTO_POLICY_CI_TARGET=0.08
# Residents sampled per neighbourhood for /api/neighbourhood-acceptance
# (src/lib/citizen-reaction/neighbourhood-acceptance.ts).
TECHTO_NEIGHBOURHOOD_SAMPLE_SIZE=3

# Optional: Next app base URL used by the FastAPI stub in services/transit-core
# (falls back to TECHTO_NEXT_BASE_URL, then http://localhost:3000). The Next app
# itself does not read this.
# NEXT_PUBLIC_TRANSIT_API_BASE_URL=http://localhost:3000

# Transit data repository: "fixture" (local src/data/transit) or "mongo"
# (Atlas; run `npm run mongo:bootstrap` first). Tests should use fixture.
TECHTO_REPOSITORY_PROVIDER=fixture

# MongoDB Atlas (server-only; never expose to the browser).
# Used by `npm run mongo:status`, `npm run mongo:bootstrap`, and mongo repository.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/
# Optional read-only URI for agent run_python (falls back to MONGODB_URI).
# Prefer an Atlas user with find/aggregate only (no insert/update/delete).
# MONGODB_URI_READONLY=
MONGODB_DATABASE=techto
MONGODB_SEARCH_INDEX=techto-search
MONGODB_VECTOR_INDEX=techto-memory-vector

# Python research tooling (model/serving.py, eval/): OpenAI-compatible
# endpoint for persona-opinion generation.
# TECHTO_LLM_BASE_URL=
# TECHTO_LLM_API_KEY=
# TECHTO_LLM_MODEL=
